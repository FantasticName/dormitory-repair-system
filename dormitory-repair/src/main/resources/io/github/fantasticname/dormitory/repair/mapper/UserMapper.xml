<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fantasticname.dormitory.repair.mapper.UserMapper">



<!--其实这玩意儿可以不写，因为我已经在mybatis-config.xml中设置了自动映射驼峰命名-->
    <resultMap id="BaseResultMap" type="io.github.fantasticname.dormitory.repair.entity.User">
        <id column="id" property="id"/>
        <result column="account" property="account"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="name" property="name"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>



<!--    SQL语句，对应的是entity包下面的接口-->
    <select id="findUserByAccount" resultMap="BaseResultMap">
        select * from user where account = #{account}
    </select>

    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        insert into user (account, password, role, name, created_at, updated_at)
        values (#{account}, #{password}, #{role}, #{name}, NOW(), NOW())
    </insert>



    <select id="findUserById" resultMap="BaseResultMap">
        select * from user where id = #{id}
    </select>


    <update id="updatePassword">
        update user set password = #{password}, updated_at = NOW()
        where id = #{id}
    </update>



</mapper>