<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.fantasticname.dormitory.repair.mapper.DormBindingMapper">



    <!--其实这玩意儿可以不写，因为我已经在mybatis-config.xml中设置了自动映射驼峰命名-->
    <resultMap id="BaseResultMap" type="io.github.fantasticname.dormitory.repair.entity.DormBinding">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="building" property="building"/>
        <result column="room" property="room"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>



    <select id="findDormBindingInfoByUserId" resultMap="BaseResultMap">
        select * from dorm_binding where user_id = #{userId}
    </select>

    <insert id="insertDormBindingInfo" useGeneratedKeys="true" keyProperty="id">
        insert into dorm_binding (user_id, building, room, created_at)
        values (#{userId}, #{building}, #{room}, now())
    </insert>

    <update id="updateDormBindingInfo">
        update dorm_binding
        set building = #{building}, room = #{room}
        where id = #{id}
    </update>
</mapper>